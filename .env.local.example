# Copy this file to .env.local and fill it in. .env.local is git-ignored;
# never commit real values.

# --- Backend ---------------------------------------------------------------
# Where the Express API runs.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# MUST be the same value as JWT_SECRET in server/.env, or every login fails.
# Production refuses to start without it: the app would otherwise accept
# tokens signed with a public fallback, which anyone can forge.
JWT_SECRET=

# --- Browser push notifications -------------------------------------------
# Leave false until the Express API has the routes in
# docs/push-notifications-backend.md. Restart `npm run dev` after changing it.
NEXT_PUBLIC_PUSH_ENABLED=false

# Generate a key pair once with:  npx web-push generate-vapid-keys
# Every environment that shares customers (e.g. production) must keep the
# SAME pair: changing it silently stops push for everyone who turned it on.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address push services can reach about problems. Use the shop's own.
VAPID_SUBJECT=mailto:owner@example.com
